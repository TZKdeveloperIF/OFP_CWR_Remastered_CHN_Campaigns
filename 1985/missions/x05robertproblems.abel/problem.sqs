_pozice = getpos m60
_x=_pozice select 0
_y=_pozice select 1
_z=_pozice select 2
hammer SetPos [_x-3.4, _y,_z+7]
[hammer] allowgetin false
unassignvehicle hammer
hammer switchmove "StandGetOutTank"
3 fadeMusic 0.0

~2
titleCut ["","BLACK OUT",1]
m60 SetPos getmarkerpos "sem"
hammer say "x05v01"
~1

[hammer] allowgetin false
unassignvehicle hammer
hammer SetPos [6009.33,8720.73,0]
hammer switchmove "EffectStand"
hammer setspeedmode "limited"
off SetPos [6000.71,8719.99,0]
hammer move [6002.12,8719.55,0]
off dowatch hammer
hammer dowatch off 
off reveal hammer
hammer reveal off
hammer SetPos [6002.12,8719.55,0]
hammer setdir -90
off SetPos [6000.71,8719.99,0]
off setdir 90
off setmimic "normal"

 


