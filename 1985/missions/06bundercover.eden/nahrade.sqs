_camera camSetTarget [-87304.16,23681.80,-11589.00]
_camera camSetPos [9385.26,1058.11,25.80]
_camera camSetFOV 0.781
_camera camCommit 0
@camCommitted _camera
~2

contin=true

titleCut ["","BLACK OUT",2]
~2

@camCommitted _camera

~2

player cameraEffect ["terminate","back"]
camDestroy _camera


ForceEnd
