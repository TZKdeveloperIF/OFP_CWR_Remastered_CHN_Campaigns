titleCut ["","BLACK IN",1000]


;NASTAVUJEME POZICE
guba setUnitPos "up"
group player reveal guba
player doWatch guba
player dotarget guba

group guba reveal player
guba doWatch player
;NASTAVUJEME POZICE
~2
titleCut ["","BLACK IN",3]


;BLBOSTI NA ZACATEK
"1" objStatus "done"
enableRadio false
0 fadeMusic 0.1
playmusic "Track2"
;BLBOSTI NA ZACATEK
guba stop true

_pG = getPos Guba
_x = _pG select 0
_y = _pG select 1

_pG = [_x, _y - 4, 0]

player setPos _pG

guba setDir 180
player setDir 0

;inicializace kamer
_camera = "camera" camCreate [9578.59,3540.29,1.66]
_camera cameraEffect ["internal","back"]

