;definovat senzor v krajine cheat1 s onactivation cheat1=false; jmenovojaka exec "nazev.sqs"
; spustit script camera.sqs a to treba pres debug window Rshift+C. zde vypis player exec camera.sqs. Camera se ukoncuje "V"
;init (START kamery nutne ke spusteni kamery)
_camera = "camera" camCreate [-89784.22,7493.73,-8681.15] 
_camera cameraEffect ["internal","back"]
playmusic "track9"
0 fademusic 0.1
setacctime 1.0
_czechVoice = voiceLanguage == "Czech"

titleCut ["","BLACK IN",3]

;NASTAVUJEME POZICE-*-*-*-*-*-*
david SetPos [5540.89,4835.68,0]
david setdir 330
david stop true
david switchmove "FXStandSurUniv"
david setmimic "normal"
;c1 stop true
;c2 stop true
;hlidka1 stop true

c1 SetPos [5544.49,4834.62,0]
c1 setdir 270
c1 setbehaviour "combat"
c1 setunitpos "up"
c2 SetPos [5541.29,4831.25,0]
c2 setbehaviour "combat"
c2 setunitpos "up"
c2 setdir 350
c1 stop true
c1 reveal david
c2 reveal david
c2 dowatch david
hlidka1 setbehaviour "combat"
hlidka switchmove "EffectCombatStand"
hlidka1  setunitpos "up"
hlidka stop true

;NASTAVUJEME POZICE***********

