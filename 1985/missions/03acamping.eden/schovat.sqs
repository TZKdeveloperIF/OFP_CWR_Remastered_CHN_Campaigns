_obj = vlajka
_x = getpos _obj select 0; _y = getpos _obj select 1; _z = getpos _obj select 2; _obj setPos [_x, _y-2000, _z-20]

_i = 0
_vsechny = [stan, stan1, stan2, plot1, plot2, palety, pristresek]
_j = count _vsechny

#znovu
_obj = _vsechny select  _i
_x = getpos _obj select 0; _y = getpos _obj select 1; _z = getpos _obj select 2; _obj setPos [_x, _y, _z-20]
_i = _i + 1
? _i >= _j : goto "konec"
goto "znovu"
#konec