; _this [group, position, target]

? leader player == player : goto "sam"

_group = _this select 0
_targetPos = _this select 1
_units = units _group
_leader = leader _group

_units commandMove _targetPos

[player] commandMove getMarkerPos "wm"

~90

_ostatni = units group player - [player]
"_x setDammage 1" forEach _ostatni



;hrac zustal sam

#sam

player sideRadio "05br24"
[west, "hq"] sideRadio "05br20"

