; _this [group, position, target]

_group = _this select 0
_targetPos = _this select 1
_units = units _group
_leader = leader _group

_units commandMove _targetPos

[player, voj1, voj2, voj3] commandMove getMarkerPos "pos1"
@unitReady vojak2
[player, voj1, voj2, voj3] commandMove getMarkerPos "pos2"

@unitReady voj1
@unitReady _leader

[player, voj1, voj2, voj3] doFollow leader group player
