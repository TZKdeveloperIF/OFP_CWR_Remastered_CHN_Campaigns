;definovat senzor v krajine cheat1 s onactivation cheat1=false; jmenovojaka exec "nazev.sqs"
; spustit script camera.sqs a to treba pres debug window Rshift+C. zde vypis player exec camera.sqs. Camera se ukoncuje "V"
;init (START kamery nutne ke spusteni kamery)
_camera = "camera" camCreate [-89784.22,7493.73,-8681.15]
_camera cameraEffect ["internal","back"]


titleCut ["","BLACK IN",3]
enableRadio false
playmusic ["track6",10]
0 fademusic 0.4



;NASTAVUJEME POZICE-*-*-*-*-*-*
;straz1 setBehaviour "Safe"
;straz2 setBehaviour "Safe"

;NASTAVUJEME POZICE-*-*-*-*-*-*

david setPos getMarkerPos "hracpozice"
david setdir 140
david switchmove "CombatRelaxed"
david stop true

;NASTAVUJEME POZICE-*-*-*-*-*-*

straz1 setPos getMarkerPos "pozice1"
straz1 setBehaviour "Combat"
straz1 setunitpos "up"
straz1 stop true

straz2 setPos getMarkerPos "pozice2"
straz2 setBehaviour "Combat"
straz2 setunitpos "up"
straz2 stop true

straz1 setDir 180
straz2 setDir 180

straz1 reveal david
straz2 reveal david

straz1 dowatch david
straz2 dowatch david

straz1 dotarget david
straz2 dotarget david


