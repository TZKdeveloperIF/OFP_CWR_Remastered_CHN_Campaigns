showCinemaBorder false
0 fademusic 1.5
playmusic "7thLifeless"
mg1 setunitpos "down"
mg2 setunitpos "down"
AT1 dotarget tank
AT2 dotarget tank
AT3 dotarget tank


removeallweapons kamila
