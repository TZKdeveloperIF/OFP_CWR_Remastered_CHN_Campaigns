;definovat senzor v krajine cheat1 s onactivation cheat1=false; jmenovojaka exec "nazev.sqs"
; spustit script camera.sqs a to treba pres debug window Rshift+C. zde vypis player exec camera.sqs. Camera se ukoncuje "V"
;init (START kamery nutne ke spusteni kamery)
_camera = "camera" camCreate [-89784.22,7493.73,-8681.15] 
_camera cameraEffect ["internal","back"]
titleCut ["","BLACK IN",1]

setacctime 1.0
guba setPos [1896.126,7391.056,4]
guba setDir 76
guba setbehaviour "careless"
guba removeweapon "AK74"
angel setPos [1899.644,7389.482,4]
angel  setDir -67
angel stop true
angel setbehaviour "careless"
guba dowatch angel
angel dowatch guba
guba removeweapon "binocular"
sluha1 setPos [1906.658,7388.322,4]
sluha2  setPos [1900.207,7395.046,4]
sluha3  setPos [1903.671,7385.575,4]
sluha4 setPos [1903.556,7389.694,4]
sluha3 switchmove "OnChair"
sluha stop true
guba setmimic "angry"
angel setmimic "normal"
;angel switchmove "FXStandhip"
angel switchmove "FXangel"

