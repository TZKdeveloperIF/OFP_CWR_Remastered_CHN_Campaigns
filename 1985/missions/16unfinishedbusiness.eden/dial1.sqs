aGuard setbehaviour "SAFE"
aP playmove "effectstand"
aL playmove "effectstand"
aGuard playmove "effectstand"

aGuard setPos getMarkerPos "C1"
aGuard setDir 180
aP setPos getMarkerPos "C2"
aP setDir 10
aL setPos getMarkerPos "C3"
aL setDir 340

