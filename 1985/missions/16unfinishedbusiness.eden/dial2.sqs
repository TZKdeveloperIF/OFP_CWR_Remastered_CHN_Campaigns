_camera = "camera" camCreate [-89784.22,7493.73,-8681.15] 
_camera cameraEffect ["internal","back"]
jet=false
setacctime 1.0
_czechVoice = voiceLanguage == "Czech"
enableRadio false
aL removeweapon "NVgoggles"
aP setbehaviour "SAFE"
aL setbehaviour "SAFE"
of setbehaviour "CARELESS"
aP playmove "effectstand"
aL playmove "effectstand"
of playmove "effectstand"
aP stop true 
aL stop true 
of stop true 


of setunitpos "UP"

of setPos getMarkerPos "C21"
of setDir 190
aP setPos getMarkerPos "C22"
aP setDir 10
aL setPos getMarkerPos "C23"
aL setDir 340

