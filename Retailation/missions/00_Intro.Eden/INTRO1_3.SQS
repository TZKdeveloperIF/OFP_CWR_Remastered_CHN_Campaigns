5 fadeMusic 1
playmusic "inside_music1_13"

camera1_3_1 setpos [getpos camera1_3_1 select 0, getpos camera1_3_1 select 1, (getpos camera1_3_1 select 2) + 0]

_camera = "camera" camCreate [0,0,0]
_camera cameraeffect ["internal", "back"]

_camera camsettarget camera3
_camera camsetpos [(getpos camera1_2 select 0) - 0, (getpos camera1_2 select 1) - 0, (getpos camera1_2 select 2) + 1.2]
_camera camsetfov 0.500
_camera camCommit 0
~0.01

_camera camsettarget camera3_2
_camera camsetpos [(getpos camera3 select 0) - 0, (getpos camera3 select 1) - 0, (getpos camera3 select 2) + 1.2]
_camera camsetfov 0.500
_camera camCommit 200
~30

playsound "fx04"
titlecut["","black out",0.5]
~0.5
_aunits = units yashar
_i = 0
_j = count _aunits
#start
(_aunits select _i) setpos getpos pos1
_i = _i + 1
?_i < _j: goto "start"
~1.5
titlecut["","black in",1]

c8 switchmove "FXWomanSur"
c8 dowatch pos1
_camera camsettarget camera1_3_4
_camera camsetpos [(getpos camera1_3_3 select 0) - 0, (getpos camera1_3_3 select 1) - 0, (getpos camera1_3_3 select 2) + 1.2]
_camera camsetfov 0.400
_camera camCommit 0
@civdead

_camera camsettarget camera1_3_1
_camera camsetpos [(getpos camera1_3 select 0) - 0, (getpos camera1_3 select 1) - 0, (getpos camera1_3 select 2) + 1.3]
_camera camsetfov 0.500
_camera camCommit 3
5 fadeMusic 0
~5

titlecut["","black out",1]
~1

[] exec "intro2.sqs"

exit
