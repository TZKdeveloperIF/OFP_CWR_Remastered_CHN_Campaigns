cutRsc ["Warning", "PLAIN", 0]
~10
titlecut["","black in",999999999999999999999999999999999999999999999999]
titletext [localize "STR_Load1_0","plain",1]
~5
titletext [localize "STR_Load1_1","plain",1]
~5
titlecut["","black in",1]
titletext ["","plain",1]

playmusic "inside_music1_13"

;анимация людей у церкви
c8 switchmove "FXInHand"

_camera = "camera" camCreate [0,0,0]
_camera cameraeffect ["internal", "back"]

camera1_1 setpos [getpos camera1_1 select 0,getpos camera1_1 select 1,(getpos camera1_1 select 2)+5.5]
camera1 setpos [getpos camera1 select 0,getpos camera1 select 1,(getpos camera1 select 2)+5.5]
camera1_3_1 setpos [getpos camera1_3_1 select 0, getpos camera1_3_1 select 1, (getpos camera1_3_1 select 2) + 13]

;titletext ["","plain",1]

;камера смотрит вверх
_camera camsettarget camera1_3_1
_camera camsetpos [(getpos camera1_3 select 0) - 0, (getpos camera1_3 select 1) - 0, (getpos camera1_3 select 2) + 1.3]
_camera camsetfov 0.500
_camera camCommit 0
~3
c5 switchmove "FXInKneel"

_camera camsettarget camera1_3_4
_camera camsetpos [(getpos camera1_3 select 0) + 3, (getpos camera1_3 select 1) + 1, (getpos camera1_3 select 2) + 2]
_camera camsetfov 0.500
_camera camCommit 5
~1
~4

titlecut["","black out",1]
~1
titlecut["","black in",1]

_camera camsettarget camera1_3_4
_camera camsetpos [(getpos camera1_3_3 select 0) - 0, (getpos camera1_3_3 select 1) - 0, (getpos camera1_3_3 select 2) + 1.3]
_camera camsetfov 0.400
_camera camCommit 0

;анимация людей у церкви
c6 switchmove "FXCivilHandMouth"
~4
c5 switchmove "FXFromKneel"
~1

titlecut["","black out",1]
~1
titlecut["","black in",1]

_camera camsettarget policecar
_camera camsetrelpos [0,2.5,-0.55]
_camera camsetfov 0.500
_camera camCommit 0
~3

_camera camsettarget police1
_camera camsetrelpos [0,0.8,1.5]
_camera camsetfov 0.700
_camera camCommit 0
~2

_camera camsettarget police1
_camera camsetrelpos [-1,1.5,1.5]
_camera camsetfov 0.900
_camera camCommit 5
~4

phasa1=true

~1

titlecut["","black out",1]
~1

[] exec "intro1_1.sqs"

exit
