;titlecut["","black in",999999999999999999999999999999999999999999999999]
;titletext [localize "STR_Load1_0","plain",1]
;~2
;titlecut["","black in",1]

titlecut["","black in",1]

_camera = "camera" camCreate [0,0,0]
_camera cameraeffect ["internal", "back"]

;titletext ["","plain",1]

_count1 = 160
_count2 = 170
_count3 = 130

[] exec "restalk1.sqs"

;показываем разговор боевиков в машине
#sc1
_camera camsettarget pv1
_camera camsetrelpos [0,3.1,0.3]
_camera camsetfov 0.600
_camera camCommit 0
_count1 = _count1 - 1
?_count1 == 0: goto "sc2"
~0.005
goto "sc1"

#sc2
_camera camsettarget pv1
_camera camsetrelpos [0.8,2.7,0.25]
_camera camsetfov 0.500
_camera camCommit 0
_count2 = _count2 - 1
?_count2 == 0: goto "sc3"
~0.005
goto "sc2"

#sc3
_camera camsettarget pv1
_camera camsetrelpos [0.0,-3,0.25]
_camera camsetfov 0.500
_camera camCommit 0
_count3 = _count3 - 1
?_count3 == 0: goto "sc4"
~0.005
goto "sc3"


;titlecut["","black out",1]
;~0.5
;titlecut["","black in",1]

;_camera camsettarget camera1_3_4
;_camera camsetpos [(getpos camera1_3_3 select 0) - 0, (getpos camera1_3_3 select 1) - 0, (getpos camera1_3_3 select 2) + 1.3]
;_camera camsetfov 0.400
;_camera camCommit 0
;~5

;[] exec "intro1_2.sqs"

exit
