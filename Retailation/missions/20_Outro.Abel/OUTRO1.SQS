;camera1_4 setpos [(getpos camera1_4 select 0), (getpos camera1_4 select 1), (getpos camera1_4 select 2) + 1]

blake switchmove "FXStandAtt"
general dowatch blake

titlecut["","black in",999999999999999999999999999999999999999999999999]
titletext [localize "STR_Load1_0","plain",1]
~5
;titletext [localize "STR_Load3_2","plain",1]

titlecut["","black in",1]

titletext ["","plain",1]

_camera = "camera" camCreate [0,0,0]
_camera cameraeffect ["internal", "back"]

_camera camsettarget tank1
_camera camsetrelpos [2,5,-0.3]
_camera camsetfov 0.400
_camera camCommit 0
~3

titlecut["","black out",1]
titlecut["","black in",1]

_camera camsettarget general
_camera camsetpos [(getpos camera1_4 select 0), (getpos camera1_4 select 1), (getpos camera1_4 select 2) + 3]
_camera camsetfov 0.800
_camera camCommit 0
~3

general switchmove "EffectStandTalk"
_camera camsettarget camera1_1
_camera camsetpos [(getpos camera1 select 0) - 0, (getpos camera1 select 1) + 0, (getpos camera1 select 2) + 1.5]
_camera camsetfov 0.400
_camera camCommit 0

_camera camsettarget camera1_2
_camera camsetpos [(getpos camera1 select 0) - 0, (getpos camera1 select 1) + 0, (getpos camera1 select 2) + 1.5]
_camera camsetfov 0.800
_camera camCommit 10
~10

titlecut["","black out",1]
titlecut["","black in",1]

_camera camsettarget general
_camera camsetrelpos [0.3,0.7,1.65]
_camera camsetfov 0.600
_camera camCommit 0
general say "outro0_1"
~7

_camera camsettarget blake
_camera camsetrelpos [-0.8,0.9,1.65]
_camera camsetfov 0.600
_camera camCommit 0
blake say "outro0_2"
~4

_camera camsettarget general
_camera camsetrelpos [-0.3,2.9,1.7]
_camera camsetfov 0.500
_camera camCommit 0
general say "outro0_3"
~5.5

_camera camsettarget blake
_camera camsetrelpos [-0.3,2.7,1.65]
_camera camsetfov 0.500
_camera camCommit 0
general say "outro0_4"
~5

_camera camsettarget blake
_camera camsetrelpos [-0.3,0.7,1.65]
_camera camsetfov 0.800
_camera camCommit 0
blake say "outro0_5"
~4

_camera camsettarget blake
_camera camsetrelpos [0.3,0.7,1.65]
_camera camsetfov 0.800
_camera camCommit 5
blake say "outro0_6"
~5

_camera camsettarget general
_camera camsetrelpos [0.5,1.9,1.65]
_camera camsetfov 0.500
_camera camCommit 0
general say "outro0_7"
~6.5

_camera camsettarget blake
_camera camsetrelpos [1.3,2.7,1.65]
_camera camsetfov 0.800
_camera camCommit 0
blake say "outro0_8"
~3.5

_camera camsettarget general
_camera camsetrelpos [1.3,2.7,1.65]
_camera camsetfov 0.800
_camera camCommit 0
general say "outro0_9"
~9.5

_camera camsettarget general
_camera camsetrelpos [1.0,1.7,1.65]
_camera camsetfov 0.500
_camera camCommit 5
general say "outro0_10"
~4

_camera camsettarget blake
_camera camsetrelpos [0,0.7,1.65]
_camera camsetfov 0.400
_camera camCommit 0
blake say "outro0_11"
~4.8

_camera camsettarget general
_camera camsetrelpos [0,0.7,1.65]
_camera camsetfov 0.400
