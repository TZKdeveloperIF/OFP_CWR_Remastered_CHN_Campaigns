
camera1_3 setpos [getpos general select 0, getpos general select 0, (getpos general select 0) + 7]


titlecut["","black in",999999999999999999999999999999999999999999999999]
titletext [localize "STR_Load3_1","plain",1]
~5
general switchmove "FXStandTelLoop"
of switchmove "OnChair"
titletext [localize "STR_Load3_2","plain",1]
~5
playsound "ring"
~2
titlecut["","black in",1]

titletext ["","plain",1]

_camera = "camera" camCreate [0,0,0]
_camera cameraeffect ["internal", "back"]

_camera camsettarget camera1_1
_camera camsetpos [(getpos camera1 select 0) - 0.9, (getpos camera1 select 1) + 3, (getpos camera1 select 2) - 0.4]
_camera camsetfov 0.500
_camera camCommit 0

_camera camsettarget camera1_1
_camera camsetpos [(getpos camera1 select 0) - 1, (getpos camera1 select 1) + 2, (getpos camera1 select 2) + 0]
_camera camsetfov 0.500
_camera camCommit 5
playsound "ring"
~2
general say "intro3_0"
~4
general say "intro3_1"

_camera camsettarget camera1_1
_camera camsetpos [(getpos camera1_2 select 0) - 0, (getpos camera1_2 select 1) + 0, (getpos camera1_2 select 2) + 0]
_camera camsetfov 0.500
_camera camCommit 7
~5
general say "intro3_2"
~1

_camera camsettarget camera1_1
_camera camsetpos [(getpos camera1_2 select 0) - 0, (getpos camera1_2 select 1) + 0, (getpos camera1_2 select 2) + 0]
_camera camsetfov 0.500
_camera camCommit 0
~4

titlecut["","black out",1]
~1
titlecut["","black in",1]

_camera camsettarget camera1_1
_camera camsetpos [(getpos camera1_2 select 0) - 0, (getpos camera1_2 select 1) + 0, (getpos camera1_2 select 2) + 0]
_camera camsetfov 0.300
_camera camCommit 0
general say "intro3_3"

_camera camsettarget camera1_1
_camera camsetpos [(getpos camera1_2 select 0) - 0, (getpos camera1_2 select 1) + 0, (getpos camera1_2 select 2) + 0]
_camera camsetfov 0.200
_camera camCommit 6
~6
general say "intro3_4"
~7

_camera camsettarget camera1_1
_camera camsetpos [(getpos camera1_2 select 0) - 0, (getpos camera1_2 select 1) - 0.5, (getpos camera1_2 select 2) + 0]
_camera camsetfov 0.400
_camera camCommit 3
general say "intro3_5"
~6

_camera camsettarget camera1_1
_camera camsetpos [(getpos camera1_2 select 0) - 0, (getpos camera1_2 select 1) - 0.6, (getpos camera1_2 select 2) + 0]
_camera camsetfov 0.400
_camera camCommit 3
general say "intro3_6"
~5

_camera camsettarget camera1_1
_camera camsetpos [(getpos camera1_2 select 0) - 0, (getpos camera1_2 select 1) - 0.8, (getpos camera1_2 select 2) + 0.3]
_camera camsetfov 0.400
_camera camCommit 3
general say "intro3_7"
~2

titlecut["","black out",1]
~1
titlecut["","black in",1]

general switchmove "FXStandDropTel"
_camera camsettarget camera1_4
_camera camsetpos [(getpos general select 0) - 0.2, (getpos general select 1) + 0.7, (getpos general select 2) + 4.2]
_camera camsetfov 0.300
_camera camCommit 0
general say "intro3_8"
~2

general say "intro3_9"
~4

;titlecut["","black out",1]
;~1

[] exec "intro2.sqs"

exit
