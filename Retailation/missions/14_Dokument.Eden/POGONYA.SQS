
_ld = _this select 0
_pl = _this select 1
_firedistance = _this select 2

_ld dotarget _pl
_ld setformation "WEDGE"
_ld setcombatmode "RED"
_ld setspeedmode "NORMAL"
_ld setbehaviour "AWARE"
_ld allowFleeing 0

#cycle1
?backuped: goto "cycle2"
_ld move getpos _pl
?_pl distance _ld <= _firedistance: _ld reveal _pl; _ld dofire _pl
~20
goto "cycle1"

#cycle2
_pl setcaptive true
_ld move getpos base1

exit
