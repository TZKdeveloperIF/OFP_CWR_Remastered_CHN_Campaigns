_camera = "camera" camCreate (getpos PK1)
_camera cameraEffect ["internal","back"]
TitleText ["Южнее Монтигнака. Утро 14 Мая.","PLAIN"]
titleCut ["","BLACK IN",5]

0 Fademusic 0.4
Playmusic "inside_music1_11"

_camera camSetTarget off
_camera camSetPos  [getPos PK1 select 0, getPos Pk1 select 1, (getPos Pk1 select 2) + 7]
_camera camSetFOV 0.800
_camera camCommit 0
@camCommitted _camera


_camera camSetTarget off
_camera camSetPos   [getPos PK2 select 0, getPos Pk2 select 1, (getPos Pk2 select 2) + 1.6]
_camera camSetFOV 0.800
_camera camCommit 35
~5
TitleText ["","PLAIN"]
Off say "Intro1"
~5
Off say "Intro2"
~3
Off say "Intro3"
~3
Up_2 say "Intro4"
~2
Off say "Intro5"
~5
Off say "Intro6"
~5
Off say "Intro7"
~8
@camCommitted _camera

