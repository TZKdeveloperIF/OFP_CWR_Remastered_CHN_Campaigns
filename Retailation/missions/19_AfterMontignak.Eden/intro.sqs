_camera camSetTarget tr1
_camera camSetPos  [getPos PK3 select 0, getPos Pk3 select 1, (getPos Pk3 select 2) + 2]
_camera camSetFOV 0.800
_camera camCommit 2.7

@camCommitted _camera
10 Fademusic 0
