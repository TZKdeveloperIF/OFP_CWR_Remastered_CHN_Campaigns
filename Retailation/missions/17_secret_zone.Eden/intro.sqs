_camera camSetTarget gen
_camera camSetPos  [getPos PK1 select 0, getPos Pk1 select 1, (getPos Pk1 select 2) + 2]
_camera camSetFOV 0.800
_camera camCommit 0
@camCommitted _camera
"zone" setMarkerSize [0, 0]

