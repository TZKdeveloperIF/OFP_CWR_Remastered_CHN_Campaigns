_camera camsetrelpos [0.1,0.7,1.65]
_camera camsetfov 0.800
_camera camCommit 0
~6

west1 say "intro2_1"
_camera camsettarget west1
_camera camsetrelpos [0.1,1.7,1.65]
_camera camsetfov 0.800
_camera camCommit 5
~3.5

