~5
titlecut["","black in",1]

_camera = "camera" camCreate [0,0,0]
_camera cameraeffect ["internal", "back"]

titletext ["","plain",1]

_camera camsettarget [(getpos flag2 select 0) - 0, getpos flag2 select 1, (getpos flag2 select 2) + 6]
_camera camsetpos [(getpos flag2 select 0) - 2, getpos flag2 select 1, (getpos flag2 select 2) + 6]
_camera camsetfov 0.500
_camera camCommit 0
~5

_camera camsettarget w1
_camera camsetrelpos [0,0.7,1.65]
_camera camsetfov 0.600
_camera camCommit 0
~0

_camera camsettarget w2
_camera camsetrelpos [0,0.9,1.65]
_camera camsetfov 0.650
_camera camCommit 3
~3

