titlecut["","black in",999999999999999999999999999999999999999999999999]
;titletext [localize "STRM_Load_1","plain",1]
;~2
titletext [localize "STRM_Load_2","plain",1]
~4

0 fademusic 1
playmusic "inside_music1_15"

~1
titlecut["","black in",1]

_camera = "camera" camCreate [0,0,0]
_camera cameraeffect ["internal", "back"]

playsound "intro1_0"
_camera camsettarget rad3
_camera camsetpos [(getpos camera1 select 0) - 0, (getpos camera1 select 1) - 0, (getpos camera1 select 2) + 1.3]
_camera camsetfov 0.800
_camera camCommit 0
~5

playsound "intro1_1"
_camera camsettarget rad3
_camera camsetpos [(getpos camera2 select 0) - 0, (getpos camera2 select 1) - 0, (getpos camera2 select 2) + 1.3]
_camera camsetfov 0.800
_camera camCommit 15
~9
playsound "intro1_2"
~3
playsound "intro1_3"
~5
playsound "intro1_4"
~4
playsound "intro1_5"
~2
;rad5 switchmove "EffectStandTalk"
;~1
;rad4 switchmove "EffectStandTalk"

_camera camsettarget spec
_camera camsetpos [(getpos camera2 select 0) - 0, (getpos camera2 select 1) - 0, (getpos camera2 select 2) + 1.3]
_camera camsetfov 0.400
_camera camCommit 6
spec say "intro1_6"
~5

_camera camsettarget sol1
_camera camsetpos [(getpos camera2 select 0) - 0, (getpos camera2 select 1) - 0, (getpos camera2 select 2) + 1.3]
_camera camsetfov 0.800
_camera camCommit 5
sol1 switchmove "EffectStandSalute"
~0.5
sol1 switchmove "EffectStandSaluteEnd"
sol1 say "intro1_7"
~3

fase1=true
spec say "intro1_8"
5 fademusic 0
~2

titlecut["","black out",3]

terstart=true

~3

[] exec "outro1.sqs"
