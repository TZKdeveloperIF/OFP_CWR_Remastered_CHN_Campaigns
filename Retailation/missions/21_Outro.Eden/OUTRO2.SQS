
o fademusic 1
playmusic "inside_music1_14"
~1
titlecut["","black in",1]

;titletext ["","plain",1]

_camera = "camera" camCreate [0,0,0]
_camera cameraeffect ["internal", "back"]

_camera camsettarget a1
_camera camsetrelpos [7,200,0]
_camera camsetfov 0.700
_camera camCommit 0
~15

#sc0
_camera camsettarget a1
_camera camSetRelPos [0,8,1.3]
_camera camSetFOV 0.500
_camera camCommit 0
~0.005
?scene == 1: goto "sc1"
goto "sc0"

#sc1
_camera camsettarget [(getpos a1 select 0) + 25, (getpos a1 select 1) + 8, (getpos a1 select 2) + 1.7]
_camera camsetpos [(getpos a1 select 0) - 500, (getpos a1 select 1) - 5, (getpos a1 select 2) - 1]
_camera camsetfov 0.300
_camera camCommit 0
~0.005
?scene == 2: goto "sc2"
goto "sc1"


#sc2
_camera camsettarget a1
_camera camSetRelPos [7,-7,-2.3]
_camera camSetFOV 0.500
_camera camCommit 0
~0.0005
?scene == 3: goto "sc3"
goto "sc2"

#sc3
_camera camsettarget [(getpos a1 select 0) + 1.5, (getpos a1 select 1) + 4, (getpos a1 select 2) + 1]
_camera camsetpos [(getpos a1 select 0) + 3, (getpos a1 select 1) - 3, (getpos a1 select 2) + 1]
_camera camsetfov 0.300
_camera camCommit 0
~0.005
?bombd: goto "sc4"
goto "sc3"

#sc4
_camera camsettarget target
_camera camsetpos [(getpos a1 select 0) - 1, (getpos a1 select 1) + 20, (getpos a1 select 2) + 30]
_camera camsetfov 0.800
_camera camCommit 0
0

_camera camsettarget target
_camera camsetrelpos [0,0,20]
_camera camsetfov 0.800
_camera camCommit 15
10 fademusic 0
~10

titlecut["","black out",1]
~1
titlecut["","black in",1]

_camera camsettarget camera2_1
_camera camsetpos [(getpos camera2 select 0) - 0, (getpos camera2 select 1) + 0, (getpos camera2 select 2) + 4.0]
_camera camsetfov 0.800
_camera camCommit 0

_camera camsettarget camera2_1
_camera camsetpos [(getpos camera2 select 0) - 0, (getpos camera2 select 1) + 0, (getpos camera2 select 2) + 15.0]
_camera camsetfov 0.800
_camera camCommit 10
~15

titlecut["","black out",1]
~1

_camera cameraeffect ["terminate", "back"]
camdestroy _camera

[] exec "outro3.sqs"

exit
