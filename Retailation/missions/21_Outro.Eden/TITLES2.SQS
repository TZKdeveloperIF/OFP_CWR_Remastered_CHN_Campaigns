_camera camsetfov 0.500
_camera camCommit 3
~3

tit_ver2 setfuel 1

_camera camsettarget tit_civ1_1_2
_camera camsetpos [(getpos tit_med1_2 select 0) + 0.5, (getpos tit_med1_2 select 1) + 0.5, (getpos tit_med1_2 select 2) + 1]
_camera camsetfov 0.500
_camera camCommit 5
~7

_camera camsettarget tit_camera2_1
_camera camsetpos [(getpos tit_camera2 select 0) - 0, (getpos tit_camera2 select 1) + 0, (getpos tit_camera2 select 2) + 4.5]
_camera camsetfov 0.700
_camera camCommit 15
~2

cutRsc ["Testers1", "PLAIN", 5]

~3
