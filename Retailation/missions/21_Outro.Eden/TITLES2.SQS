_camera camsettarget object 4867
_camera camsetpos [(getpos object 4867 select 0) + 23, (getpos object 4867 select 1) + 0, (getpos object 4867 select 2) + 14.7]
_camera camsetfov 0.300
_camera camCommit 0

_camera camsettarget object 4867
_camera camsetpos [(getpos object 4867 select 0) + 30, (getpos object 4867 select 1) + 0, (getpos object 4867 select 2) + 14.7]
_camera camsetfov 0.900
_camera camCommit 10
~1

cutRsc ["Kartodel", "PLAIN", 5]

~9

titlecut["","black out",0.5]
