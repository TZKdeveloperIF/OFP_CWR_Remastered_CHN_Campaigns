0 fademusic 0
of switchmove "OnChair"
of1 switchmove "OnChair"
of2 switchmove "OnChair"
sel switchmove "OnChair"

titlecut["","black in",999999999999999999999999999999999999999999999999]
titletext [localize "STR_Load3_1","plain",1]
~5
titletext [localize "STR_Load3_2","plain",1]
~5
playmusic "inside_music1_15"
0 fademusic 1
titlecut["","black in",1]

titletext ["","plain",1]

_camera = "camera" camCreate [0,0,0]
_camera cameraeffect ["internal", "back"]

camera1_1 setpos [(getpos camera1_1 select 0), (getpos camera1_1 select 1), (getpos camera1_1 select 2) + 5]
_camera camsettarget camera1_1
_camera camsetpos [(getpos camera1 select 0) - 0, (getpos camera1 select 1) + 0, (getpos camera1 select 2) + 4]
_camera camsetfov 0.700
_camera camCommit 0

_camera camsettarget camera1_1
_camera camsetpos [(getpos camera1 select 0) - 0, (getpos camera1 select 1) + 0, (getpos camera1 select 2) + 5.3]
_camera camsetfov 0.700
_camera camCommit 5
~5

titlecut["","black out",1]
~1
titlecut["","black in",1]

camera1_3 setpos [(getpos camera1_3 select 0), (getpos camera1_3 select 1), (getpos camera1_3 select 2) + 5]
