_camera camsetpos [(getpos camera1_2 select 0) - 0, (getpos camera1_2 select 1) + 0, (getpos camera1_2 select 2) + 5.6]
_camera camsetfov 0.700
_camera camCommit 0
general say "outro3_0"
~2.5

