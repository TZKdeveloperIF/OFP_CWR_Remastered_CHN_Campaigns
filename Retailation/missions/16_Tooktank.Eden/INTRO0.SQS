setacctime 1.0

titlecut["","black in",9999999999999999999999999999999999999999999999999]

;titletext [localize "STR_Load0_0","plain",1]
~3
titlecut["","black in",1]

titletext ["","plain down",1]

_camera = "camera" camCreate getpos cam1
_camera cameraeffect ["internal", "back"]

_camera camsettarget cam1_1
_camera camsetpos [(getpos cam1 select 0),(getpos cam1 select 1),(getpos cam1 select 2)+ 1]
_camera camsetfov 0.800
_camera camCommit 0

0 fademusic 1
playmusic "inside_music1_1"

_camera camsettarget cam1_1
_camera camsetpos [(getpos cam1 select 0),(getpos cam1 select 1),(getpos cam1 select 2)+ 10]
_camera camsetfov 0.200
_camera camCommit 7
~10

_camera camsettarget ab1
_camera camsetpos [(getpos cam1 select 0),(getpos cam1 select 1),(getpos cam1 select 2)+ 10]
_camera camsetfov 0.300
_camera camCommit 3
~3

_camera camsettarget ab2
_camera camsetpos [(getpos cam1 select 0),(getpos cam1 select 1),(getpos cam1 select 2)+ 10]
_camera camsetfov 0.400
_camera camCommit 3
~3

_camera camsettarget cam1_1
_camera camsetpos [(getpos cam1 select 0),(getpos cam1 select 1),(getpos cam1 select 2)+ 13]
_camera camsetfov 0.100
_camera camCommit 5
5 fademusic 0
~5

titlecut["","black out",3]
~3

skipTime 1

[] exec "intro1.sqs"

exit
