
_camera = "camera" camCreate (getpos Mi)
_camera cameraEffect ["internal", "Back"]

titleCut ["","BLACK IN",3]

playsound "fx12"
_camera camSetTarget zem
_camera camSetPos  [getPos PK1 select 0, getPos Pk1 select 1, (getPos Pk1 select 2) + 48]
_camera camSetFOV 0.800
_camera camCommit 0
@camCommitted _camera

sea = "seagull" camcreate  [getPos PS select 0, getPos PS select 1, (getPos PS select 2) + 48]
sea setdir 180

titletext [localize "STR_Intro1","plain down"]

_camera camSetTarget Mi
_camera camSetPos  [getPos PK1 select 0, getPos Pk1 select 1, (getPos Pk1 select 2) + 48]
_camera camSetFOV 0.400
_camera camCommit 10
@camCommitted _camera
