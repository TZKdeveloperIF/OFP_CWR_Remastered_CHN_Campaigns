
disableuserinput true
_camera = "camera" camCreate [getpos astahov_p select 0, getpos astahov_p select 1, (getpos astahov_p select 2) + 1.5]
_camera cameraeffect ["internal", "back"]
titleCut ["","BLACK OUT",3]

Gamer switchmove "stand"
Gamer setdammage 0
Gamer setpos (getpos astahov_p)
Gamer setdir 20
~2
titleCut ["","BLACK IN",3]
; Camera na gamere
_camera camsettarget gamer
_camera camsetrelpos [1,2,1.7]
_camera camSetFOV 0.538
_camera camcommit 0
~0.5
gamer Switchmove "EffectStandSalute"
~6
gamer Switchmove "EffectStandSaluteEnd"

; Camera na kommandire
_camera camsettarget kommander
_camera camsetrelpos [-2,3,1.7]
_camera camSetFOV 0.538
_camera camcommit 1.3 

; Voinskoe privetstvie pri vhode kommander
kommander Switchmove "FXStandFromTable"
kommander DoWatch gamer
~1.5
kommander Switchmove "EffectStandSalute"
~0.5
kommander Switchmove "EffectStandSaluteEnd"

; Voinskoe privetstvie pri vhode kommander_1
kommander_1 Switchmove "FXStandFromTable"
kommander_1 DoWatch gamer
~1.5
kommander_1 Switchmove "EffectStandSalute"
~0.5
kommander_1 Switchmove "EffectStandSaluteEnd"
~0.3
kommander_1 DoWatch kommander
~1
_camera camsettarget kommander_1
_camera camsetrelpos [-1,1,1.6]
_camera camSetFOV 0.538
_camera camcommit 1 
kommander_1 Stop FALSE

;Razgovor s igrokom
kommander Switchmove "EffectStandTalk"
~10

; Razgovor gamer
gamer SetMimic "sad"
_camera camsettarget gamer
_camera camsetrelpos [0,1,1.7]
_camera camcommit 1.5 
~6

; Razgovor kommander
_camera cameraEffect ["Fixed", "Back"] 
_camera camsettarget kommander
_camera camsetrelpos [1,-1,1.6]
_camera camcommit 1
~ 5
disableuserinput false
END=1
_camera cameraEffect ["terminate","BACK"]
camDestroy _camera
exit