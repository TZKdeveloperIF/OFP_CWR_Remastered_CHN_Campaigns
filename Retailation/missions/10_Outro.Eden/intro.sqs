#otl
_cycle=0
#cycle_st
_camera camSetTarget AH1
_camera camSetRelPos [0,5,0]
_camera camSetFOV 0.800
_camera camCommit 0
@camCommitted _camera
~0.01
_cycle = _cycle + 1
?_cycle == 350: (gunner AH1) say "intro33"
?_cycle == 400: (driver AH1) say "missle"
?_cycle == 420: (gunner AH1) say "intro34"
?_cycle == 440: _gg = "AA" camcreate [(getpos AH1 select 0),(getpos AH1 select 1), (getpos AH1 select 2)+2]
?_cycle < 480:goto "cycle_st"

titleCut ["","BLACK OUT",5]
~5
end = true
exit

