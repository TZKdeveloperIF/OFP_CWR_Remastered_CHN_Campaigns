setacctime 1.0

gameri switchmove "EffectStandSitDown"
gameri setbehaviour "CARELESS"

q1 setpos getpos out1
q2 setpos getpos out1
q2 setpos getpos out1
gam1 setpos getpos out1

_camera = "camera" camCreate [0,0,0]
_camera cameraeffect ["internal", "back"]

playmusic "inside_music1_5"

titlecut["","black in",3]

_camera camsettarget gameri
_camera camsetpos [(getpos pod select 0) + 5, (getpos pod select 1) - 5, (getpos pod select 2) + 2.5]
_camera camsetfov 0.800
_camera camCommit 0
~5

titlecut["","black out",1]
~1
titlecut["","black in",1]

_camera camsettarget gameri
_camera camsetpos [(getpos pod select 0) + 0.6, (getpos pod select 1) + 0.3, (getpos pod select 2) + 1.1]
_camera camsetfov 0.800
_camera camCommit 0
~1
gameri say "game1_0"
~8
gameri say "game1_1"
~9

_camera camsettarget gameri
_camera camsetpos [(getpos pod select 0) + 0.6, (getpos pod select 1) + 0.3, (getpos pod select 2) + 1.1]
_camera camsetfov 0.500
_camera camCommit 5
gameri say "game1_2"
~5

titletext ["","plain down",1]
_camera camsettarget g1i
_camera camsetrelpos [6,1.3,1.5]
_camera camsetfov 0.800
_camera camCommit 0
~3

com1 stop false

_camera camsettarget com1
_camera camsetpos [(getpos cam1 select 0) + 0.6, (getpos cam1 select 1) + 0.3, (getpos cam1 select 2) + 1.1]
_camera camsetfov 0.800
_camera camCommit 6
~6

_camera camsettarget com1
_camera camsetrelpos [-1,0.5,1.5]
_camera camsetfov 0.800
_camera camCommit 0
com1 say "intro0_1"
~3

_camera camsettarget com1
_camera camsetrelpos [0,0.7,1.5]
_camera camsetfov 0.800
_camera camCommit 0
com1 say "intro0_2"
~5

_camera camsettarget com1
_camera camsetrelpos [0,-2,1.7]
_camera camsetfov 0.800
_camera camCommit 0
g1i say "intro0_3"
~2

_camera camsettarget com1
_camera camsetrelpos [1,0.5,1.5]
_camera camsetfov 0.800
_camera camCommit 0
com1 say "intro0_4"
~3

titlecut["","black out",1]
~0.5
titlecut["","black in",1]

g1i say "intro0_6"
start=true
_camera camsettarget com1
_camera camsetpos [(getpos cam1 select 0) + 0.6, (getpos cam1 select 1) + 0.3, (getpos cam1 select 2) + 1.1]
_camera camsetfov 0.800
_camera camCommit 0
~5

titlecut["","black out",3]
~3

[] exec "intro0.sqs"

exit
