_camera = "camera" camCreate (getpos PK1)
_camera cameraEffect ["internal","back"]
TitleText ["弗农。\n维和部队哨卡。","PLAIN"]
titleCut ["","BLACK IN",5]
playsound "Fx05"

_camera camSetTarget Tent
_camera camSetPos  [getPos PK1 select 0, getPos Pk1 select 1, (getPos Pk1 select 2) + 10]
_camera camSetFOV 0.800
_camera camCommit 0
@camCommitted _camera

akt1 switchmove "CargoVer2"
