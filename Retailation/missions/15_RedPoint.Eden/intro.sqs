_camera = "camera" camCreate (getpos PK1)
_camera cameraEffect ["internal","back"]
TitleText ["Линия обороны Монтигнака.","PLAIN"]
titleCut ["","BLACK IN",100]
0 Fademusic 1
Playmusic "inside_music1_14"
~2
titleCut ["","BLACK IN",5]

_camera camSetTarget Up
_camera camSetPos  [getPos PK1 select 0, getPos Pk1 select 1, (getPos Pk1 select 2) + 2]
_camera camSetFOV 0.800
_camera camCommit 0
@camCommitted _camera
~10

_camera camSetTarget Up
_camera camSetRelPos [1,0,0.3]
_camera camSetFOV 0.800
_camera camCommit 0
@camCommitted _camera
[puli,1,1,1,5] exec "bullet.sqs"
~1
Up reveal cel
Up dotarget cel
Up dofire cel

_camera camSetTarget Up
_camera camSetRelPos [0,2,0.3]
_camera camSetFOV 0.800
_camera camCommit 3
@camCommitted _camera

~5
scen = 1
~3
_camera camSetTarget off
_camera camSetPos  [getPos PK1 select 0, getPos Pk1 select 1, (getPos Pk1 select 2) + 5]
_camera camSetFOV 0.800
_camera camCommit 0
@camCommitted _camera

@scen == 2

_camera camSetTarget Up
_camera camSetRelPos [-0.4,3,0.4]
_camera camSetFOV 0.800
_camera camCommit 0
@camCommitted _camera

Off say "intro1"
~5
Up say "intro2"
~5
[puli2,1,5,1,3] exec "bullet.sqs"
Off say "intro3"
~3
Up say "intro4"
~2

off domove (getpos cel_baze)
~5
Up say "intro5"
~6
titleCut ["","BLACK OUT",5]
5 Fademusic 0
~5
scen = 10
exit
