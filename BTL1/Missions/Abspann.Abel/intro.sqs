playmusic "deep"
1 fademusic 1.5
1 fadesound 1

cam_start setpos[getpos cam_start select 0,getpos cam_start select 1,1.5]
_camera = "camera" camCreate Getpos cam_start
_camera camsetTarget cr5
_camera camSetPos GetPos cam_start
_camera cameraEffect ["internal","back"]
_camera camCommand "inertia on"
_camera camsetTarget cr5
_camera camCommit 1
@camCommitted _camera

;load the scene so it doesn't mess up the graphics
_camera camSetPos GetPos cam_start
_camera camCommit 6
~8
CutText [localize "STRNG_508","PLAIN",5]
~6
CutText [localize "STRNG_509","PLAIN",2]
~6
CutText [localize "STRNG_510","PLAIN",1]
~3
_camera camsetTarget cr1
_camera camSetRelPos [0.2,1.5,1]
_camera camCommit 0
CutText [localize "STRNG_511","PLAIN DOWN",3]
~8
_camera camsetTarget cr2
_camera camSetRelPos [0.2,1.5,1]
_camera camCommit 2
CutText [localize "STRNG_512","PLAIN DOWN",3]
~8
_camera camsetTarget cr3
_camera camSetRelPos [0.2,1.5,1]
_camera camCommit 2
CutText [localize "STRNG_513","PLAIN DOWN",3]
~8
_camera camsetTarget cr4
_camera camSetRelPos [0.2,1.5,1]
_camera camCommit 2
CutText [localize "STRNG_514","PLAIN DOWN",3]
~8
_camera camsetTarget cr5
_camera camSetRelPos [0.2,1.5,1]
_camera camCommit 2
CutText [localize "STRNG_515","PLAIN DOWN",3]
~8
_camera camsetTarget cr6
_camera camSetRelPos [0.2,1.5,1]
_camera camCommit 2
CutText [localize "STRNG_516","PLAIN DOWN",3]
~8
_camera camsetTarget cr7
_camera camSetRelPos [0.2,1.5,1]
_camera camCommit 2
CutText [localize "STRNG_517","PLAIN DOWN",3]
~8
_camera camsetTarget cr8
_camera camSetRelPos [0.2,1.5,1]
_camera camCommit 2
CutText [localize "STRNG_518","PLAIN DOWN",3]
~8
_camera camsetTarget cr9
_camera camSetRelPos [0.2,1.5,1]
_camera camCommit 2
CutText [localize "STRNG_519","PLAIN DOWN",3]
~8
_camera camsetTarget cr5
_camera camSetPos GetPos cam_start
_camera camCommit 6
~3
CutText [localize "STRNG_522","PLAIN DOWN",3]
~8
CutText [localize "STRNG_520","PLAIN DOWN",3]
~8
CutText [localize "STRNG_521","PLAIN DOWN",3]

~8
ende=true
~8
5 fademusic 0
5 fadesound .5
_camera cameraEffect ["terminate","back"]
camDestroy _camera

exit
exit
