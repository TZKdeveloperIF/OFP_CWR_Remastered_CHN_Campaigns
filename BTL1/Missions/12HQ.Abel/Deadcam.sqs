playmusic "september"
1 fademusic 1.0
titleCut ["","BLACK IN",15]
enableEndDialog
_camera = "camera" camCreate Getpos startCam 
_camera camsetTarget DeadManCross

_camera cameraEffect ["internal","back"]
_camera camCommand "inertia on"
_camera camsetTarget DeadManCross
_camera camCommit 1
@camCommitted _camera

_camera camSetRelPos [0,4,1]
_camera camCommit 7
~6
_camera camSetRelPos [-5,0,1]
_camera camCommit 7
~6
_camera camSetRelPos [0,-6,1]
_camera camCommit 8
~7
_camera camSetRelPos [7,-16,1]
_camera camCommit 15
~15
_camera camSetRelPos [13,-1,1]
_camera camCommit 15
~3
CutText [localize "STRNG_484","PLAIN",1]
~12

_player cameraEffect ["terminate","back"]
camDestroy _camera
exit
