playmusic "cesna"
1 fademusic 1.5
1 fadesound 2

_camera = "camera" camCreate Getpos startCam 
_camera camsetTarget firstTarget
_camera camSetPos GetPos startCam
titleCut ["","BLACK IN",15]
_camera cameraEffect ["internal","back"]
_camera camCommand "inertia on"
_camera camsetTarget firstTarget
_camera camCommit 1
@camCommitted _camera

;load the scene so it doesn't mess up the graphics
~4
_camera camSetTarget Angreifer_1
